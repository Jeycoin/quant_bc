# --- Safety switch ---
# LIVE_TRADING=true enables real trading. Anything else = PAPER (default).
LIVE_TRADING=false

# --- LLM (multi-provider; switch with LLM_PROVIDER) ---
LLM_PROVIDER=anthropic          # anthropic | openai_compat

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI-compatible (Alibaba Bailian/DashScope, DeepSeek, Kimi, Zhipu, ...)
# LLM_PROVIDER=openai_compat
# Bailian:   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1                        LLM_MODEL=deepseek-chat
# Kimi:      LLM_BASE_URL=https://api.moonshot.cn/v1                         LLM_MODEL=kimi-k2-0905-preview
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Hummingbot API (the MCP server wraps this) ---
HUMMINGBOT_API_URL=http://localhost:8000
HUMMINGBOT_USERNAME=admin
HUMMINGBOT_PASSWORD=admin

# --- Hummingbot MCP server launch (stdio) ---
# hummingbot-mcp 1.0.4 requires mcp SDK <2, so run it in an isolated uvx env
MCP_HUMMINGBOT_COMMAND=uvx
MCP_HUMMINGBOT_ARGS=--from hummingbot-mcp --with mcp>=1.0,<2 hummingbot-mcp
